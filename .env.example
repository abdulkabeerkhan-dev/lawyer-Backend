# Vector search (judgments + statutes)
ZILLIZ_URI=https://your-cluster.serverless.gcp-us-west1.cloud.zilliz.com
ZILLIZ_TOKEN=your_zilliz_api_key_here
ZILLIZ_COLLECTION=judgments_v1
ZILLIZ_STATUTES_COLLECTION=statutes_v3
USE_ZILLIZ_STATUTES=true

VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-4-large

# Case metadata, users, query history
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Judgment texts, original PDFs and legacy statutes (Cloudflare R2, read-only key is enough)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=section-judgment-texts
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5

INPUT_DIR=D:\
