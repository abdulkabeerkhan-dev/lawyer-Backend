    "primary_num": "4",
    "secondary_num": null,
    "title": "Succession of grandchildren in case of death of any son or daughter of the propositus",
    "title_only": "Succession of grandchildren in case of death of any son or daughter of the propositus",
    "text": "In the event of the death of any son or daughter of the propositus before the opening of the succession, the children of such son or daughter, if any, living at the time the succession opens, shall per stirpes receive a share equivalent to the share which such son or daughter, as the case may be, would have received if alive.",
    "jurisdiction": "federal",
    "status": "declared_repugnant_appeal_pending",
    "enacted_date": "1961-03-02",
    "assent_date": "1961-03-02",
    "commencement_date": null,
    "effective_application": "pending_and_prospective",
    "ordinance_expiry_date": null,
    "court_challenges": [
      {
        "court": "Federal Shariat Court",
        "case_citation": "PLD 2000 FSC 1",
        "case_name": "Allah Rakha and others v. Federation of Pakistan and others",
        "ruling": "Section 4 was declared repugnant to the Injunctions of Islam (effective 31 March 2000) to the extent that it permits orphaned grandchildren to inherit without reference to Islamic principles of exclusion or the shares of other Quranic heirs.",
        "appeal_status": "Civil Appeals pending before Supreme Court of Pakistan Shariat Appellate Bench (Shariat Appeals No. 2 to 5 of 2000, 2000 SCMR 1251).",
        "effective_legal_effect": "Under Articles 203D and 203F of the Constitution of Pakistan 1973, when an appeal is preferred before the Supreme Court Shariat Appellate Bench against an FSC declaration of repugnancy, the declaration does not take effect until the disposal of the appeal. Section 4 remains substantive statutory law in force in Pakistan pending the Supreme Court's decision."
      }
