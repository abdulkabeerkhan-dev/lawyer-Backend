  {
    "act_code": "FIO_2001",
    "act_name": "Financial Institutions (Recovery of Finances) Ordinance, 2001",
    "provision_type": "section",
    "primary_num": "9",
    "secondary_num": null,
    "canonical_id": "FIO_2001_SEC_9",
    "display_name": "Section 9",
    "title": "Procedure of Banking Court",
    "verbatim_text": "(1) Where a customer or a financial institution commits a default in fulfillment of any obligation, the financial institution or, as the case may be, the customer, may institute a suit in the Banking Court by presenting a plaint which shall be verified on oath.\n(2) The plaint shall be supported by a statement of account verified on oath in terms of the Bankers' Books Evidence Act, 1891.",
    "provisos": [],
    "explanations": [],
    "jurisdiction": "federal",
    "status": {
      "federal": "in_force",
