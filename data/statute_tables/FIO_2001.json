    "verified": true
  },
  {
    "act_code": "FIO_2001",
    "act_name": "Financial Institutions (Recovery of Finances) Ordinance, 2001",
    "provision_type": "section",
    "primary_num": "10",
    "secondary_num": null,
    "canonical_id": "FIO_2001_SEC_10",
    "display_name": "Section 10",
    "title": "Leave to defend",
    "verbatim_text": "(1) The defendant shall not be entitled to defend the suit unless he applies for and obtains leave from the Banking Court as hereinafter provided.\n(2) The application for leave to defend shall be filed within thirty days of the date of first service by any of the prescribed modes.\n(3) The application for leave to defend shall be in the form of a written statement verified on oath and shall state the specific amount of finance availed, repayments made, and the exact amount disputed.\n(4) If the defendant fails to file an application for leave to defend within thirty days, the Banking Court shall pass a decree forthwith.",
    "provisos": [],
    "explanations": [],
    "jurisdiction": "federal",
    "status": {
      "federal": "in_force",
      "punjab": "in_force",
      "sindh": "in_force",
      "kp": "in_force",
      "balochistan": "in_force"
    },
    "superseded_reference": null,
    "source_citation": "Pakistan Code (pakistancode.gov.pk), Ordinance XLVI of 2001",
    "source_verified_date": "2026-09-23",
    "verified": true
  },
  {
